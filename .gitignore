# An allowlist: only code, small results and run summaries are tracked. Never secrets/, models/, venv/,
# runs/*/work (raw pass outputs), paper/edits (edit tensors) or eval/raw (downloaded data). See README, "Paper data".
/*
!/.gitignore
!/README.md
!/RESULTS.md
!/plans/
!/train/
/train/runs/
/train/evals/
/train/combined/
/train/checks/*.log
/train/tests/work/
# the probe texts hold dataset problems; the activations are about 40 MB a model (train/probes.py)
/train/analysis/probes/texts.jsonl
/train/analysis/probes/*.npz
/train/analysis/probes/log
/train/analysis/probes/batch.log

!/harness/
__pycache__/
*.pyc

!/scripts/
!/baseline/

!/scratch/
/scratch/*/
/scratch/*.log
/scratch/*.out
/scratch/*.pgid

!/eval/
/eval/*
!/eval/*.py
!/eval/*.out
!/eval/Dockerfile.grade
!/eval/ifeval/
!/eval/results/
/eval/results/*/*
!/eval/results/*/report.json
!/eval/results/*/report.md
!/eval/results/*/config.json
!/eval/results/*/submission/
/eval/results/*/submission/*
!/eval/results/*/submission/manifest.json

!/paper/
/paper/edits/
/paper/code/
/paper/data/.cache.json

!/runs/
/runs/*
!/runs/pilot-*/
!/runs/combo-*/
!/runs/panel-*/
/runs/*/*
!/runs/*/brief.md
!/runs/*/config.json
!/runs/*/state.json
!/runs/*/label.txt
!/runs/*/final_answer.md
!/runs/*/explanations.md
!/runs/*/driver.log
!/runs/*/edits.jsonl
!/runs/*/submission/
/runs/*/submission/*
!/runs/*/submission/manifest.json
!/runs/*/submission/report.md

# 60 MB of raw baseline generations; reproducible, too big for GitHub
/baseline/gen.jsonl
